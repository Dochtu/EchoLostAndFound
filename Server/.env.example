# Copy to `.env` for local runs, then start with:
#   set -a; source .env; set +a   (bash)  /  $env:X="y" (PowerShell)
# NEVER commit a real .env or a real API key. The browser/Unity client must
# never contain any of these secrets. This file only contains placeholders.

# ------------------------------------------------------------------ service
SERVICE_NAME=echolostfound-npc-ai
API_VERSION=1.0
SCHEMA_VERSION=1
CONTENT_DIR=app/content
LOG_LEVEL=INFO

# ------------------------------------------------------------- entry / model
# Explicit single switch. `mock` (default) never calls an external model.
# `live` requires MODEL_PROVIDER=llm, a valid provider config, a usable budget
# ledger and a matching epoch sentinel; otherwise startup is refused.
APP_ENTRY_MODE=mock

# disabled | mock | llm
# In mock mode MODEL_PROVIDER must stay `mock` (or `disabled`); the process
# refuses to start with MODEL_PROVIDER=llm and APP_ENTRY_MODE=mock.
MODEL_PROVIDER=mock

# Only used when APP_ENTRY_MODE=live + MODEL_PROVIDER=llm. Example base URL
# includes the API version; `/chat/completions` is appended by the adapter.
LLM_BASE_URL=https://your-openai-compatible-host.example.com/v1
LLM_MODEL=replace-with-a-model-id
LLM_API_KEY=replace-with-a-server-side-key
LLM_PROVIDER_ID=external-llm
# Cap for one upstream call. Also bounds the local queue wait for a slot.
AI_TIMEOUT_MS=12000
# Hard caps on one upstream request.
LLM_MAX_OUTPUT_TOKENS=220
LLM_INPUT_MAX_CHARS=800
# Simultaneous upstream calls (1..8). Extra turns wait, then degrade locally.
LLM_MAX_CONCURRENCY=2
# Optional: ask an OpenAI-compatible endpoint for a JSON object reply.
LLM_JSON_MODE=false

# ------------------------------------------------------- token / context budget
# R1: the request budget above is not enough on its own. These caps bound the
# *whole* model context, not just the player's text. Every upstream call first
# reserves llm_token_reservation tokens in the ledger, so a crash or a missing
# usage block can never look "free".
# Total context window we are willing to send plus request.
LLM_CONTEXT_MAX_TOKENS=1536
# System prompt budget (role + rules + the NPC's own knowledge scope).
LLM_SYSTEM_PROMPT_MAX_TOKENS=768
# Evidence/topic context section budget inside the system prompt.
LLM_EVIDENCE_CONTEXT_MAX_TOKENS=320
# Reserved for prior conversation history. 0 = no history is sent at all.
LLM_HISTORY_MAX_TOKENS=0
# Whole-ledger token budget. The ledger refuses once settled+reserved exceeds it.
LLM_TOKEN_LIMIT=60000
# Per-request reservation. 0 means "context_max + max_output" is used.
LLM_TOKEN_RESERVE_PER_REQUEST=0
# Optional pin: the exact ledger epoch this deployment expects. A mismatch
# (for example after somebody reset the ledger) refuses startup instead of
# silently granting a fresh quota.
LLM_LEDGER_EPOCH_PIN=
# Mark requests to a *test* upstream as synthetic (see Server/tools/fake_llm_server.py).
LLM_TEST_UPSTREAM=false
LLM_TEST_UPSTREAM_HEADER=x-test-upstream

# -------------------------------------------------------------- budget ledger
# Test quota only. M5-C-A does not grant production quota; choose real limits
# deliberately and record the decision in the deployment runbook.
LLM_REQUEST_LIMIT=30
LLM_REQUEST_LIMIT_PER_SESSION=8
# Must both live on durable, writable storage. Docker VOLUME alone is not a
# platform persistence guarantee on ModelScope (only /mnt/workspace persists).
LLM_USAGE_PATH=.local/llm-usage.sqlite3
LLM_LEDGER_EPOCH_PATH=.local/epoch/ledger-epoch.json
# Consecutive upstream/model failures before the breaker opens.
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_SECONDS=60

# --------------------------------------------------------------- interaction
PLAYER_INPUT_MAX_CHARS=1000
REQUEST_MAX_BYTES=32768
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=512

# --------------------------------------------------------------------- CORS
# Comma-separated explicit origins. Never use `*`; the client is public.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ------------------------------------------------------------ abuse controls
# These are independent buckets; every business API request consumes one
# global token, and the matching bucket below.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
CLIENT_RATE_LIMIT_PER_MINUTE=60
CLIENT_RATE_LIMIT_BURST=30
SESSION_TURN_RATE_PER_MINUTE=30
SESSION_TURN_RATE_BURST=10
NEW_SESSION_RATE_PER_MINUTE=20
NEW_SESSION_RATE_BURST=5

# X-Forwarded-For is ignored unless the direct peer is inside one of these
# CIDRs. Never list 0.0.0.0/0 or ::/0. Leave empty when the platform proxy
# topology is not verified (the safe default; records a launch blocker).
TRUSTED_PROXY_CIDRS=
TRUST_FORWARDED_FOR=false

# ---------------------------------------------------------------- local auth
# Optional shared token for a private deployment. Leave empty to disable.
# This is NOT a substitute for TLS or real user auth.
# ModelScope Studios occupy the `Authorization` header, so the default is a
# custom header. Only set LOCAL_AUTH_HEADER=Authorization off-platform.
LOCAL_AUTH_TOKEN=
LOCAL_AUTH_HEADER=X-Dialogue-Token
