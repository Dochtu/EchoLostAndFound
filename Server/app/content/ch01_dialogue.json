  "disclosures": [
    {
      "disclosure_id": "D01",
      "npc_id": "npc_laozhou",
      "kind": "testimony",
      "required_evidence_ids": ["E02"],
      "segments": [
        {
          "content_ref": "dialogue.CH01.D01.laozhou",
          "text": "进水，二十一点十七。我的灯到二十才摆好。是黑过，中间那点我记混了。"
        }
      ]
    },
    {
      "disclosure_id": "D02",
      "npc_id": "npc_laozhou",
      "kind": "verification",
      "required_evidence_ids": ["E03", "E04"],
      "segments": []
    },
    {
      "disclosure_id": "D03",
      "npc_id": "npc_laozhou",
      "kind": "testimony",
      "required_evidence_ids": ["E01", "E05"],
      "segments": [
        {
          "content_ref": "dialogue.CH01.D03.laozhou",
          "text": "她抓住小姑娘的胳膊，表掉到台沿。我弯腰拣的时候指针已经不动了，冠头是歪的。"
        }
      ]
    },
    {
      "disclosure_id": "D02",
      "npc_id": "npc_linyao",
      "kind": "testimony",
      "required_evidence_ids": ["E03", "E04"],
      "segments": [
        {
          "content_ref": "dialogue.CH01.D02.linyao",
          "text": "沈禾，是我妈妈。这个号和她放在家里那张一样。她写着要我自己领。"
        }
      ]
    },
    {
      "disclosure_id": "REC.engraving",
