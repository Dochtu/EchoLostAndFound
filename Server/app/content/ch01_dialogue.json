    {
      "npc_id": "npc_linyao",
      "display_name": "林遥",
      "allowed_evidence_ids": ["E01", "E03", "E04"],
      "opening_segments": [
        {
          "content_ref": "dialogue.CH01.opening.linyao",
          "text": "公告上有一张我妈留的领取凭号。我把原来的带来了。表还在吗？"
        }
      ],
      "topics": [
        {
          "topic_id": "opt.linyao.ask_engraving",
          "label": "问她表背刻字的含义",
          "requires_observed_field_ids": ["watch.back_engraving"],
          "segments": [
            {
              "content_ref": "dialogue.CH01.linyao.engraving",
              "text": "四月十二是我妈的生日，九月十六是我的。那个点，我小时候摸得到。柜里究竟是不是那一只，你得对上号。"
            }
          ]
        },
        {
          "topic_id": "opt.linyao.ask_other",
          "label": "问表以外的事",
          "segments": [
            {
              "content_ref": "dialogue.CH01.linyao.refusal",
              "text": "表的事按签单。别的今天先别问。"
            }
          ]
        },
        {
          "topic_id": "opt.linyao.leave",
          "label": "结束对话",
          "segments": []
        }
      ],
      "free_text_intents": [
        {
          "keywords": ["背刻", "表背", "刻字"],
          "topic_id": "opt.linyao.ask_engraving"
        },
        {
          "keywords": ["闲聊", "别的", "闲话"],
          "topic_id": "opt.linyao.ask_other"
