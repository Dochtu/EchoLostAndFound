      "opening_segments": [
        {
          "content_ref": "dialogue.CH01.opening.laozhou",
          "text": "这封从旧库搬过两回。我来对号，你来签。先看表背，失物只认号。"
        }
      ],
      "topics": [
        {
          "topic_id": "opt.laozhou.ask_b01",
          "label": "问站台那晚的照明",
          "segments": [
            {
              "content_ref": "dialogue.CH01.B01.initial",
              "text": "站台那晚在我印象里一直亮着。我还把那盏油灯拖到里头去了。"
            }
          ]
        },
        {
          "topic_id": "opt.laozhou.repeat_b01",
